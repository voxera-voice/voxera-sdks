{
  "name": "@voxera/sdk-web",
  "version": "0.4.1",
  "description": "Voxera WebRTC SDK for browsers",
  "license": "MIT",
  "author": "Voxera <voicevoxera@gmail.com>",
  "homepage": "https://voxera-voice.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxera-voice/voxera-sdks.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/voxera-voice/voxera-sdks/issues"
  },
  "keywords": [
    "voxera",
    "voice-ai",
    "webrtc",
    "mediasoup",
    "realtime",
    "sdk",
    "browser",
    "voice-agent",
    "conversational-ai",
    "voice-assistant",
    "speech-to-text",
    "text-to-speech",
    "llm"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@voxera/protocol": "^0.3.0",
    "mediasoup-client": "3.21.0",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vitest": "^2.1.9"
  }
}
